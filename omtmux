#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
	resolved="$(readlink -f -- "$script_path" 2>/dev/null || true)"
	if [ -n "$resolved" ]; then
		script_path="$resolved"
	fi
fi
repo_root="$(cd -- "$(dirname -- "$script_path")" && pwd)"
repo_perf_dir="$repo_root/omt-perf"
tmux_config_home="${XDG_CONFIG_HOME:-$HOME/.config}/tmux"
tmux_conf="$tmux_config_home/tmux.conf"
tmux_conf_local="$tmux_config_home/tmux.conf.local"
tmux_perf_dir="$tmux_config_home/omt-perf"
tmux_bin="${TMUX_PROGRAM:-tmux}"
socket_args=()

if [ -n "${TMUX_SOCKET:-}" ]; then
	socket_args=(-S "$TMUX_SOCKET")
elif [ -n "${TMUX:-}" ]; then
	socket_args=(-S "${TMUX%%,*}")
fi

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

git_status_porcelain() {
	git -C "$repo_root" status --short
}

git_is_dirty() {
	[ -n "$(git_status_porcelain)" ]
}

branch_upstream() {
	local branch="$1"
	local upstream

	upstream="$(git -C "$repo_root" rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null || true)"
	if [ -n "$upstream" ]; then
		printf '%s\n' "$upstream"
		return 0
	fi

	if git -C "$repo_root" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
		printf 'origin/%s\n' "$branch"
	fi
}

branch_sync_status() {
	local branch="$1"
	local upstream ahead behind counts

	upstream="$(branch_upstream "$branch")"
	if [ -z "$upstream" ]; then
		printf 'no-upstream'
		return 0
	fi

	counts="$(git -C "$repo_root" rev-list --left-right --count "${branch}...${upstream}" 2>/dev/null || true)"
	ahead="$(printf '%s\n' "$counts" | awk '{print $1}')"
	behind="$(printf '%s\n' "$counts" | awk '{print $2}')"
	[ -n "$ahead" ] || ahead=0
	[ -n "$behind" ] || behind=0

	if [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ]; then
		printf 'sync'
	elif [ "$ahead" -gt 0 ] && [ "$behind" -eq 0 ]; then
		printf 'ahead %s' "$ahead"
	elif [ "$ahead" -eq 0 ] && [ "$behind" -gt 0 ]; then
		printf 'behind %s' "$behind"
	else
		printf 'diverged +%s/-%s' "$ahead" "$behind"
	fi
}

tmux_get() {
	"$tmux_bin" "${socket_args[@]}" show-option -gv "$1" 2>/dev/null || true
}

tmux_set() {
	"$tmux_bin" "${socket_args[@]}" set-option -g "$1" "$2"
}

config_get() {
	local key="$1"
	local file="$tmux_conf_local"

	[ -f "$file" ] || return 0
	awk -v key="$key" '
		$1 == "set" && $2 == "-g" && $3 == key {
			sub(/^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/, "", $0)
			gsub(/^"/, "", $0)
			gsub(/"$/, "", $0)
			print $0
			exit
		}
	' "$file" 2>/dev/null || true
}

sync_branch_to_local() {
	mkdir -p "$tmux_config_home"
	ln -sfn "$repo_root/.tmux.conf" "$tmux_conf"
	cp "$repo_root/.tmux.conf.local" "$tmux_conf_local"
	rm -rf "$tmux_perf_dir"
	cp -a "$repo_perf_dir" "$tmux_perf_dir"
}

sync_runtime_scripts() {
	mkdir -p "$tmux_config_home"
	ln -sfn "$repo_root/.tmux.conf" "$tmux_conf"
	rm -rf "$tmux_perf_dir"
	cp -a "$repo_perf_dir" "$tmux_perf_dir"
}

reload_tmux() {
	if [ -f "$tmux_perf_dir/reload.sh" ]; then
		"$tmux_perf_dir/reload.sh" >/dev/null 2>&1 || true
	fi
}

current_branch() {
	git -C "$repo_root" branch --show-current
}

runtime_theme_current() {
	local theme
	theme="$(tmux_get @omt_theme_branch)"
	if [ -n "$theme" ]; then
		printf '%s\n' "$theme"
		return 0
	fi

	theme="$(config_get @omt_theme_branch)"
	printf '%s\n' "$theme"
}

display_mode_list() {
	local current
	current="$(display_mode_current)"
	for mode in square rounded diamond; do
		if [ "$mode" = "$current" ]; then
			printf '* %s\n' "$mode"
		else
			printf '  %s\n' "$mode"
		fi
	done
}

display_preset_current() {
	local preset
	preset="$(tmux_get @omt_display_preset)"
	[ -n "$preset" ] || preset="auto"
	printf '%s\n' "$preset"
}

display_preset_list() {
	local current
	current="$(display_preset_current)"
	for preset in auto full compact micro; do
		if [ "$preset" = "$current" ]; then
			printf '* %s\n' "$preset"
		else
			printf '  %s\n' "$preset"
		fi
	done
}

set_config_value() {
	local key="$1"
	local value="$2"
	local file="$tmux_conf_local"
	local tmp

	[ -f "$file" ] || die "missing $file"
	tmp="$(mktemp)"
	awk -v key="$key" -v value="$value" '
		BEGIN { updated=0 }
		$1 == "set" && $2 == "-g" && $3 == key {
			print "set -g " key " \"" value "\""
			updated=1
			next
		}
		{ print }
		END {
			if (!updated)
				print "set -g " key " \"" value "\""
		}
	' "$file" >"$tmp"
	mv "$tmp" "$file"
}

display_mode_symbols() {
	case "$1" in
	square)  printf '◼\n◻\n' ;;
	rounded) printf '●\n○\n' ;;
	diamond) printf '◆\n◇\n' ;;
	*) return 1 ;;
	esac
}

display_mode_current() {
	local full empty
	full="$("$tmux_bin" "${socket_args[@]}" show-option -gv @omt_battery_bar_symbol_full 2>/dev/null || true)"
	empty="$("$tmux_bin" "${socket_args[@]}" show-option -gv @omt_battery_bar_symbol_empty 2>/dev/null || true)"
	case "$full:$empty" in
	"◼:◻") printf 'square\n' ;;
	"●:○") printf 'rounded\n' ;;
	"◆:◇") printf 'diamond\n' ;;
	*) printf 'custom\n' ;;
	esac
}

theme_list() {
	local current runtime marker sync_state details
	current="$(current_branch)"
	runtime="$(runtime_theme_current)"
	for branch in lite arc-dark arc-light arc-glass-dark arc-glass-light; do
		marker=" "
		if [ "$branch" = "$current" ]; then
			marker="*"
		fi
		sync_state="$(branch_sync_status "$branch")"
		details="$sync_state"
		if [ "$branch" = "$runtime" ]; then
			details="$details, live"
		fi
		printf '%s %s (%s)\n' "$marker" "$branch" "$details"
	done
	if git_is_dirty; then
		printf '! worktree has local changes\n'
	fi
}

theme_names() {
	printf '%s\n' lite arc-dark arc-light arc-glass-dark arc-glass-light
}

theme_set() {
	local force="${1:-}"
	local branch="${2:-}"
	if [ "$force" != "--force" ]; then
		branch="$force"
		force=""
	fi
	theme_names | rg -x "$branch" >/dev/null || die "unknown theme branch: $branch"
	if git_is_dirty && [ "$force" != "--force" ]; then
		die "refusing to switch theme with a dirty worktree; commit/stash first or use: omtmux theme set --force $branch"
	fi
	git -C "$repo_root" checkout "$branch" >/dev/null
	sync_branch_to_local
	set_config_value "@omt_theme_branch" "$branch"
	"$tmux_bin" "${socket_args[@]}" set-option -g @omt_theme_branch "$branch" >/dev/null 2>&1 || true
	reload_tmux
	if [ -x "$tmux_perf_dir/refresh-battery-bar.sh" ]; then
		"$tmux_perf_dir/refresh-battery-bar.sh" >/dev/null 2>&1 || true
	fi
	if [ -x "$tmux_perf_dir/refresh-status-tail.sh" ]; then
		"$tmux_perf_dir/refresh-status-tail.sh" >/dev/null 2>&1 || true
	fi
	printf 'theme=%s\n' "$branch"
}

display_mode_set() {
	local mode="$1"
	local full empty
	mapfile -t symbols < <(display_mode_symbols "$mode") || die "unknown display mode: $mode"
	full="${symbols[0]}"
	empty="${symbols[1]}"
	set_config_value "@omt_display_mode" "$mode"
	set_config_value "@omt_battery_bar_symbol_full" "$full"
	set_config_value "@omt_battery_bar_symbol_empty" "$empty"
	sync_runtime_scripts
	tmux_set @omt_display_mode "$mode"
	tmux_set @omt_battery_bar_symbol_full "$full"
	tmux_set @omt_battery_bar_symbol_empty "$empty"
	if [ -x "$tmux_perf_dir/refresh-battery-bar.sh" ]; then
		"$tmux_perf_dir/refresh-battery-bar.sh" >/dev/null 2>&1 || true
	fi
	reload_tmux
	printf 'display_mode=%s\n' "$mode"
}

display_preset_set() {
	local preset="$1"
	case "$preset" in
	auto | full | compact | micro) ;;
	*) die "unknown display preset: $preset" ;;
	esac
	set_config_value "@omt_display_preset" "$preset"
	sync_runtime_scripts
	tmux_set @omt_display_preset "$preset"
	if [ -x "$tmux_perf_dir/refresh-status-tail.sh" ]; then
		"$tmux_perf_dir/refresh-status-tail.sh" --preset "$preset" >/dev/null 2>&1 || true
	fi
	reload_tmux
	printf 'display_preset=%s\n' "$preset"
}

usage() {
	cat <<'EOF'
Usage:
  omtmux theme list
  omtmux theme current
  omtmux theme set [--force] <lite|arc-dark|arc-light|arc-glass-dark|arc-glass-light>
  omtmux display mode list
  omtmux display mode get
  omtmux display mode set <square|rounded|diamond>
  omtmux display preset list
  omtmux display preset get
  omtmux display preset set <auto|full|compact|micro>
  omtmux display preview --width <n>
  omtmux doctor
EOF
}

cmd="${1:-}"
case "$cmd" in
theme)
	sub="${2:-}"
	case "$sub" in
	list) theme_list ;;
	current) current_branch ;;
	set)
		case "${3:-}" in
		--force)
			[ $# -ge 4 ] || die "missing branch"
			theme_set --force "$4"
			;;
		"")
			die "missing branch"
			;;
		*)
			theme_set "$3"
			;;
		esac
		;;
	*) usage; exit 1 ;;
	esac
	;;
display)
	sub="${2:-}"
	case "$sub" in
	mode)
		action="${3:-}"
		case "$action" in
		list) display_mode_list ;;
		get) display_mode_current ;;
		set) [ $# -ge 4 ] || die "missing mode"; display_mode_set "$4" ;;
		*) usage; exit 1 ;;
		esac
		;;
	preset)
		action="${3:-}"
		case "$action" in
		list) display_preset_list ;;
		get) display_preset_current ;;
		set) [ $# -ge 4 ] || die "missing preset"; display_preset_set "$4" ;;
		*) usage; exit 1 ;;
		esac
		;;
	preview)
		shift 2
		exec bash "$tmux_perf_dir/render-status.sh" "$@"
		;;
	*) usage; exit 1 ;;
	esac
	;;
doctor)
	shift
	exec bash "$tmux_perf_dir/doctor.sh" "$@"
	;;
""|-h|--help)
	usage
	;;
*)
	usage
	exit 1
	;;
esac
